pipeline {
    agent any

    environment {
        MAX_RESTART = '3'
    }

    stages {
        
        stage('recovery') {
            steps {
                sh '''
                    tentativi=0

                    check() {
                        curl -s --max-time 5 http://192.168.3.165:9100/metrics > /dev/null
                    }
                    restart(){
                        curl -s -X POST http://192.168.3.165:5000/restart
                    } 
                    until check
                    do
                        tentativi=$((tentativi + 1))

                        if [ "$tentativi" -gt "$MAX_RESTART" ]; then
                            echo "Superato il numero massimo di restart"
                            exit 1
                        fi

                        echo "Servizio non attivo - restart $tentativi"

                        restart
                        sleep 5
                    done 
                    echo "servizio attivo"
                '''
            }
        }
 
        stage('metriche') {
            steps {
                script {
                    env.HOSTNAME = sh(
                        script: "curl -s http://192.168.3.165:9100/metrics | grep '^node_uname_info' | grep -oP 'nodename=\"\\K[^\"]+'",
                        returnStdout: true
                    ).trim()
                    
                    env.KERNEL = sh(
                        script: "curl -s http://192.168.3.165:9100/metrics | grep '^node_uname_info' | grep -oP 'release=\"\\K[^\"]+'",
                        returnStdout: true
                    ).trim()

                    env.LOAD_AVERAGE = sh(
                        script: "curl -s http://192.168.3.165:9100/metrics | awk '/^node_load1 / {print \$2}'",
                        returnStdout: true
                    ).trim()

                    env.RAM_AVAILABLE = sh(
                        script: "curl -s http://192.168.3.165:9100/metrics | awk '/^node_memory_MemAvailable_bytes / {print \$2 / 1024 / 1024 / 1024}'",
                        returnStdout: true
                    ).trim()

                    echo "hostname: ${env.HOSTNAME}"
                    echo "kernel: ${env.KERNEL}"
                    echo "load average: ${env.LOAD_AVERAGE}"
                    echo "available ram: ${env.RAM_AVAILABLE} GB"
                }
            }
        }

        stage('body email') {
            steps {
                mail to: 'jenny.bellucci@sourcesense.com',
                    subject: 'metriche',
                    body: """
                    metriche vm ${env.HOSTNAME}

                    kernel: ${env.KERNEL}
                    load average: ${env.LOAD_AVERAGE}
                    ram available: ${env.RAM_AVAILABLE} GB
                    """
            }
        }
    }
}

pipeline {
    agent any

    environment {
        MAX_RESTART = '{{ max_restart }}'
    }

    stages {
{% if abilita_recovery %}
        stage('recovery {{ service_name }}') {
            steps {
                sh '''
                    tentativi=0
                    check() {
                        curl -s --max-time 5 {{ check_url }} > /dev/null
                    }
                    restart(){
                        curl -s -X POST {{ restart_url }}
                    }
                    until check
                    do
                        tentativi=$((tentativi + 1))
                        if [ "$tentativi" -gt "$MAX_RESTART" ]; then
                            echo "Superato il numero massimo di restart per {{ service_name }}"
                            exit 1
                        fi
                        echo "{{ service_name }} non attivo - restart $tentativi"
                        restart
                        sleep 5
                    done
                    echo "{{ service_name }} attivo"
                '''
            }
        }
{% endif %}

{% if abilita_metriche %}
        stage('metriche {{ service_name }}') {
            steps {
                script {
{% for metrics in metriche %}
                    env.{{ m.env_var }} = sh(script: "curl -s {{ metrics_url }} | {{ m.estrazione }}", returnStdout: true).trim()
{% endfor %}
{% for metrics in metriche %}
                    echo "{{ m.etichetta }}: ${env.{{ m.env_var }}}"
{% endfor %}
                }
            }
        }
{% endif %}

{% if abilita_email %}
        stage('email') {
            steps {
                mail to: '{{ email_to }}',
                    subject: '{{ email_subject }}',
                    body: """
{% for metrics in metriche %}
                    {{ m.etichetta }}: ${env.{{ m.env_var }}}
{% endfor %}
                    """
            }
        }
{% endif %}
    }
}