pipeline {
    agent {{ item.agent }}

{% if item.abilita_deploy_rabbitmq | default(false) or item.abilita_recovery | default(false) %}
    environment {
{% if item.abilita_deploy_rabbitmq | default(false) %}
        KUBECONFIG = credentials('{{ item.credential }}')
{% endif %}
{% if item.abilita_recovery | default(false) %}
        MAX_RESTART = '{{ item.max_restart }}'
{% endif %}
    }
{% endif %}

{% if item.abilita_parametri | default(false) %}
    parameters {

        string(name: 'NAMESPACE', defaultValue: '{{ item.namespace }}', description: 'namespace dedicato rabbitmq')
        string(name: 'CLUSTERNAME', defaultValue: '{{ item.cluster }}', description: 'nome del cluster rabbitmq')

{% for u in item.users %}
        string(name: 'VHOST_{{ u.name_params }}', defaultValue: 'trove-{{ u.vhost }}', description: 'nome vhost {{ u.vhost }}')
        string(name: 'USER_{{ u.name_params }}', defaultValue: 'trove-{{ u.user }}', description: 'nome user {{ u.user }}')
        string(name: 'CREDENTIAL_ID_{{ u.name_params }}', defaultValue: '{{ u.id }}', description: 'credential id {{ u.user }}')
{% endfor %}

        choice(name: 'OPTION', choices: ['tutti'{% for u in item.users %}, '{{ u.user }}'{% endfor %}], description: 'scelta per creazione vhost e user')
    }
{% endif %}

    stages {

{% if item.abilita_download | default(false) %}
        stage('download {{ item.name_download }}') {
            steps {
{% for d in item.download %}
                sh '''
                    curl -LO "{{ d.url_download }}"
                    chmod +x {{ d.permissions }}
                '''
{% endfor %}
            }
        }
{% endif %}

{% if item.abilita_deploy_rabbitmq | default(false) %}
        stage('deploy cluster {{ item.name_deploy }}') {
            steps {
                sh """
                    {{ item.strumento }} create namespace ${params.NAMESPACE} || true
                    {{ item.strumento }} apply -f {{ item.manifest }}
                """
            }
        }
{% endif %}

{% if item.abilita_aspetta_pod | default(false) %}
        stage('aspetta pod') {
            steps {
                sh """
                    {{ item.strumento }} wait \\
                    --for=condition=AllReplicasReady=True \\
                    rabbitmqcluster/${params.CLUSTERNAME} \\
                    -n ${params.NAMESPACE} \\
                    --timeout=300s
                """
            }
        }
{% endif %}

{% if item.abilita_vhost | default(false) %}
{% for u in item.users %}
        stage('create vhost {{ u.vhost }}') {
            when {
                expression {
                    params.OPTION == '{{ u.user }}' || params.OPTION == 'tutti'
                }
            }
            steps {
                sh """
                    {{ item.strumento }} exec -n ${params.NAMESPACE} {{ item.cluster }}-server-0 -- \\
                    rabbitmqctl add_vhost ${params.VHOST_{{ u.name_params }}} || true
                """
            }
        }
{% endfor %}
{% endif %}

{% if item.abilita_user | default(false) %}
{% for u in item.users %}
        stage('create users {{ u.user }}') {
            when {
                expression {
                    params.OPTION == '{{ u.user }}' || params.OPTION == 'tutti'
                }
            }
            steps {
                withCredentials([
                    string(
                        credentialsId: params.CREDENTIAL_ID_{{ u.name_params }},
                        variable: '{{ u.id | replace("-", "_") }}'
                    )
                ]) {
                    sh """
                        {{ item.strumento }} exec -n ${params.NAMESPACE} {{ item.cluster }}-server-0 -- \\
                        rabbitmqctl add_user ${params.USER_{{ u.name_params }}} "${{ '$' }}{{ u.id | replace("-", "_") }}" || true

                        {{ item.strumento }} exec -n ${params.NAMESPACE} {{ item.cluster }}-server-0 -- \\
                        rabbitmqctl set_permissions -p ${params.VHOST_{{ u.name_params }}} ${params.USER_{{ u.name_params }}} ".*" ".*" ".*"
                    """
                }
            }
        }
{% endfor %}
{% endif %}

{% if item.abilita_recovery | default(false) %}
        stage('recovery {{ item.service_name }}') {
            steps {
                sh '''
                    tentativi=0

                    check() {
                        curl -s --max-time 5 {{ item.check_url }} > /dev/null
                    }

                    restart() {
                        curl -s -X POST {{ item.restart_url }}
                    }

                    until check
                    do
                        tentativi=$((tentativi + 1))

                        if [ "$tentativi" -gt "$MAX_RESTART" ]; then
                            echo "Superato il numero massimo di restart per {{ item.service_name }}"
                            exit 1
                        fi

                        echo "{{ item.service_name }} non attivo - restart $tentativi"
                        restart
                        sleep 5
                    done

                    echo "{{ item.service_name }} attivo"
                '''
            }
        }
{% endif %}

{% if item.abilita_metriche | default(false) %}
        stage('metriche {{ item.service_name }}') {
            steps {
                script {
{% for m in item.metriche %}
                    env.{{ m.env_var }} = sh(
                        script: 'curl -s {{ item.metrics_url }} | {{ m.estrazione }}',
                        returnStdout: true
                    ).trim()
{% endfor %}

{% for m in item.metriche %}
                    echo "{{ m.etichetta }}: ${env.{{ m.env_var }}}"
{% endfor %}
                }
            }
        }
{% endif %}

{% if item.abilita_email | default(false) %}
        stage('email') {
            steps {
                mail to: '{{ item.email_to }}',
                    subject: '{{ item.email_subject }}',
                    body: """
{% for m in item.metriche %}
                    {{ m.etichetta }}: ${env.{{ m.env_var }}}
{% endfor %}
                    """
            }
        }
{% endif %}

    }
}
