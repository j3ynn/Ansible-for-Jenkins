pipeline {
    agent any

    environment {
        MAX_RESTART = '{{ item.max_restart }}'
    }

    stages {
{% if item.abilita_recovery %}
        stage('recovery {{ item.service_name }}') {
            steps {
                sh '''
                    tentativi=0
                    check() {
                        curl -s --max-time 5 {{ item.check_url }} > /dev/null
                    }
                    restart(){
                        curl -s -X POST {{ item.restart_url }}
                    }
                    until check
                    do
                        tentativi=$((tentativi + 1))
                        if [ "$tentativi" -gt "$MAX_RESTART" ]; then
                            echo "Superato il numero massimo di restart per {{ item.service_name }}"
                            exit 1
                        fi
                        echo "{{ item.service_name }} non attivo - restart $tentativi"
                        restart
                        sleep 5
                    done
                    echo "{{ item.service_name }} attivo"
                '''
            }
        }
{% endif %}

{% if item.abilita_metriche %}
        stage('metriche {{ item.service_name }}') {
            steps {
                script {
{% for m in item.metriche %}
                    env.{{ m.env_var }} = sh(script: "curl -s {{ item.metrics_url }} | {{ m.estrazione }}", returnStdout: true).trim()
{% endfor %}
{% for m in item.metriche %}
                    echo "{{ m.etichetta }}: ${env.{{ m.env_var }}}"
{% endfor %}
                }
            }
        }
{% endif %}

{% if item.abilita_email %}
        stage('email') {
            steps {
                mail to: '{{ item.email_to }}',
                    subject: '{{ item.email_subject }}',
                    body: """
{% for m in item.metriche %}
                    {{ m.etichetta }}: ${env.{{ m.env_var }}}
{% endfor %}
                    """
            }
        }
{% endif %}
    }
}