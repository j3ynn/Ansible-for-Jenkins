pipeline {
    agent any

    environment {

        KUBECONFIG = credentials('{{ credential }}')
    }

    parameters {
        
        string(name: 'NAMESPACE', defaultValue: '{{ namespace }}', description: 'namespace dedicato rabbitmq')

        string(name: 'CLUSTERNAME', defaultValue: '{{ cluster }}', description: 'nome del cluster rabbitmq')
{% for string in users %}

        string(name: 'VHOST-NAME', defaultValue: 'trove-{{ string.vhost }}', description: 'nome vhost roma')
        string(name: 'USER-NAME', defaultValue: 'trove-{{ string.user }}', description: 'nome user roma')

        string(name: 'CREDENTIAL_ID', defaultValue: '{{ string.id }}', description: 'credential id milano')

{% endfor %}
        choice(name: 'OPTION', choices: ['tutti' , {% for string in users %} '{{ string.user }}', {% endfor %}], description: 'scelta per creatione vhost e user')
    }

    stages {

        stage('download kubectl') {
            steps {
                sh '''
                    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                '''
            }
        }

        stage('deploy cluster rabbitmq') {
            steps {
                sh """
                    ./kubectl create namespace ${params.NAMESPACE} || true
                    ./kubectl apply -f rabbitmq-trove-cluster-local.yaml
                """
            }
        }

        stage('aspetta pod') {
            steps {
                sh """
                    ./kubectl wait \
                    --for=condition=AllReplicasReady=True \
                    rabbitmqcluster/${params.CLUSTERNAME} \
                    -n ${params.NAMESPACE} \
                    --timeout=300s
                """
            }
        }

{% for vhost in users %}
        stage('create vhost {{ vhost.vhost }}') {
            when {
                expression {
                    params.OPTION == '{{ vhost.user }}' || params.OPTION == 'tutti'
                }
            }
            steps {
                sh """
                    ./kubectl exec -n ${params.NAMESPACE} trove-rabbitmq-test-server-0 -- \
                    rabbitmqctl add_vhost ${params.VHOST_NAME} || true
                """
            }
        }
{% endfor %}

{% for user in users %}
        stage('create users {{ user.user }}') {
            when {
                expression {
                    params.OPTION == '{{ user.user }}' || params.OPTION == 'tutti'
                }
            }
            steps {
                withCredentials([
                        string(credentialsId: params.CREDENTIAL_ID_ROMA , variable: '{{ user.id }}')
                ]) {
                sh """
                    ./kubectl exec -n ${params.NAMESPACE} trove-rabbitmq-test-server-0 -- \
                    rabbitmqctl add_user ${params.USER_NAME} "$trove_roma" || true
                    ./kubectl exec -n ${params.NAMESPACE} trove-rabbitmq-test-server-0 -- \
                    rabbitmqctl set_permissions -p ${params.VHOST_NAME} ${params.USER_NAME} ".*" ".*" ".*"
                """
                }
            }
        }
{% endfor %}

        stage('check') {
            steps {
                sh """
                    echo "namespace"
                    ./kubectl get namespaces
                    echo "vhost"
                    ./kubectl exec -n ${params.NAMESPACE} trove-rabbitmq-test-server-0 -- rabbitmqctl list_vhosts
                    echo "users"
                    ./kubectl exec -n ${params.NAMESPACE} trove-rabbitmq-test-server-0 -- rabbitmqctl list_users
                """
            }
        }
    }
}